FROM apache/airflow:2.9.3-python3.11
USER root
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*
USER airflow
ENV STREAMCOMMERCE_HOME=/opt/streamcommerce PYTHONPATH=/opt/streamcommerce DBT_EXECUTABLE=/opt/dbt-venv/bin/dbt
# Project libraries are installed against Airflow's constraint file; dbt lives in its own venv to avoid conflicts.
RUN pip install --no-cache-dir "pandas>=2.2.2,<2.3" "pyarrow>=16.1,<17" "duckdb>=1.0,<1.2" pyspark==3.5.1 \
    "psycopg[binary]==3.2.1" \
    --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-2.9.3/constraints-3.11.txt"
RUN python -m venv /opt/dbt-venv && /opt/dbt-venv/bin/pip install --no-cache-dir dbt-core==1.8.5 dbt-duckdb==1.8.2

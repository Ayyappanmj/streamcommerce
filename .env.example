# Copy to .env (git-ignored). Placeholders only - never commit real secrets.
STREAMCOMMERCE_DATA_DIR=./data
# PROCESSED_FORMAT: parquet or csv
PROCESSED_FORMAT=parquet
LOG_LEVEL=INFO

# Metadata store: sqlite (lightweight, default) or postgres
METADATA_BACKEND=sqlite
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=streamcommerce
POSTGRES_USER=streamcommerce
POSTGRES_PASSWORD=change-me

# Kafka / Redpanda (host-side port published by docker compose --profile streaming)
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC=orders.events
KAFKA_DLQ_TOPIC=orders.events.dlq
KAFKA_GROUP_ID=streamcommerce-consumer
LATE_EVENT_SECONDS=3600

# Optional: JSON file overriding quality rules (see src/quality/quality_rules.py)
QUALITY_RULES_PATH=

# Airflow (only used by docker-compose.airflow.yml)
STREAMCOMMERCE_SCHEDULE=@daily
STREAMCOMMERCE_CATCHUP=false
STREAMCOMMERCE_ENGINE=spark

# Optional Snowflake (leave unset to keep it disabled)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
